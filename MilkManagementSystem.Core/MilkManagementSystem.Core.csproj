  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\NotificationController.cs" />

    <Compile Remove="Controllers\NotificationDetailsController.cs" />
    <Compile Remove="Controllers\OrganizationRolesController.cs" />
    <Compile Remove="Controllers\RolesController.cs" />
    <Compile Remove="Controllers\SignUpController.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="FCMCertificates\trucktrace-318ef-firebase-adminsdk-fbsvc-e95df0eddb.json" />
    <Content Remove="FCMCertificates\trucktrace-prod-firebase-adminsdk.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Templates\EmailTemplate.html" />
    <None Remove="Templates\InvoiceTemplate.html" />
    <None Remove="Templates\InvoiceTemplate.pdf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Templates\EmailTemplate.html">
